{
  "name": "node-observability-stack",
  "version": "0.1.0",
  "private": true,
  "description": "OpenTelemetry traces, metrics and logs from an HTTP API and a queue worker, shipped through a Collector into Tempo, Prometheus and Loki with Grafana wired to link them.",
  "author": "Mohad Jillani <mohad.jillani@gmail.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mohadjillani/node-observability-stack.git"
  },
  "homepage": "https://github.com/mohadjillani/node-observability-stack#readme",
  "bugs": "https://github.com/mohadjillani/node-observability-stack/issues",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "workspaces": [
    "packages/*",
    "services/*"
  ],
  "scripts": {
    "build": "tsc -b packages/telemetry/tsconfig.build.json services/api/tsconfig.build.json services/worker/tsconfig.build.json",
    "clean": "rm -rf packages/*/dist services/*/dist coverage",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "pretest": "npm run build",
    "test": "vitest run --coverage",
    "test:watch": "vitest",
    "pretest:e2e": "npm run build",
    "test:e2e": "vitest run --config vitest.e2e.config.ts"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/node": "^22.20.1",
    "@vitest/coverage-v8": "^3.2.7",
    "bullmq": "^5.81.0",
    "eslint": "^9.39.5",
    "ioredis": "^5.11.0",
    "prettier": "^3.9.6",
    "tsx": "^4.23.13",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.68.0",
    "vitest": "^3.2.7"
  }
}
