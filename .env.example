# Shared by both services when run outside Docker (npm run dev). The compose
# stack sets its own values.
DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5432/obs
REDIS_URL=redis://127.0.0.1:6379
QUEUE_NAME=orders
LOG_LEVEL=info

# Where the OpenTelemetry SDK sends traces. Empty or unreachable is not an
# error: the SDK drops spans after its bounded queue fills and the app keeps
# running.
OTEL_EXPORTER_OTLP_ENDPOINT=http://127.0.0.1:4318
# Set to true to start without the SDK or the loader hook (the overhead baseline).
OTEL_SDK_DISABLED=false

# api
PORT=3000
SLOW_PRICING_MS=1500

# worker
API_URL=http://127.0.0.1:3000
WORKER_CONCURRENCY=5
WORKER_METRICS_PORT=9464
